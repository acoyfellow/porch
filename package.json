{
  "name": "porch",
  "version": "0.0.1",
  "description": "Your cmux sidebar on your phone. Behind Cloudflare Access, outbound-only from your Mac.",
  "type": "module",
  "license": "MIT",
  "repository": "github:acoyfellow/porch",
  "scripts": {
    "typecheck": "tsc -p . && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "build": "vite build client",
    "deploy": "vite build client && alchemy deploy",
    "daemon": "bun daemon/main.ts",
    "brand": "bun brand/build.ts",
    "dev": "vite build client && ../predict/node_modules/.bin/wrangler dev -c wrangler.dev.jsonc --port 8790 --ip 127.0.0.1",
    "daemon:dev": "PORCH_ORIGIN=http://127.0.0.1:8790 PORCH_CLIENT_ID=dev PORCH_CLIENT_SECRET=dev bun daemon/main.ts"
  },
  "dependencies": {
    "effect": "4.0.0",
    "foldkit": "0.166.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261016.1",
    "@foldkit/vite-plugin": "0.26.1",
    "@tailwindcss/vite": "4.3.3",
    "alchemy": "2.0.0-beta.83",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "^5.0.3"
  }
}
